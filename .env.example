# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
POSTGRES_DB=uniride
POSTGRES_USER=uniride
POSTGRES_PASSWORD=uniride_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://uniride:uniride_dev_password@localhost:5432/uniride

# --- Backend ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173"]

# --- Maps / Routing ---
GOOGLE_MAPS_API_KEY=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
