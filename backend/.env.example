# Copy this file to backend/.env and fill in real values. Never commit .env.
# This is separate from the root .env.example used by docker-compose. The
# FastAPI app always reads backend/.env regardless of the process's working
# directory (app/core/config.py resolves an absolute path), but in a real
# deployment (Render, etc.) these are set as actual env vars in the host's
# dashboard instead of a file - there is no .env file in production.

# development | production - production requires a real SECRET_KEY below
# (see the _forbid_default_secret_in_production guard in app/core/config.py).
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://uniride:uniride_dev_password@localhost:5432/uniride

# Generate a real one for production: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173"]

# Needs the Routes API (routes.googleapis.com) enabled on the Google Cloud
# project, not the legacy Directions API - see app/services/maps_service.py.
GOOGLE_MAPS_API_KEY=
