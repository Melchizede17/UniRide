# Copy this file to backend/.env and fill in real values. Never commit .env.
# The FastAPI app (pydantic-settings) reads this file from the backend/ working
# directory; it's separate from the root .env.example used by docker-compose.

DATABASE_URL=postgresql+psycopg://uniride:uniride_dev_password@localhost:5432/uniride
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173"]

# Needs the Routes API (routes.googleapis.com) enabled on the Google Cloud
# project, not the legacy Directions API - see app/services/maps_service.py.
GOOGLE_MAPS_API_KEY=
